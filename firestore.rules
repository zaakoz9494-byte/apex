rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin(){ return request.auth != null && exists(/databases/$(db)/documents/admin/$(request.auth.uid)); }
    match /admin/{id} { allow read: if isAdmin(); allow write: if false; } // create the admin doc manually in the console
    match /invoices/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.total is number && request.resource.data.items.size() > 0
        && request.resource.data.number is string;
      allow delete: if isAdmin();
    }
    match /{col}/{id} { allow read, write: if isAdmin() && col in ['customers','products','stockMovements','companySettings','activityLogs','backups','invoiceCounters']; }
  }
}
